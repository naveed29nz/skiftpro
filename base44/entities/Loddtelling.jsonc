{
  "name": "Loddtelling",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "butikk": {
      "type": "string"
    },
    "uke_nummer": {
      "type": "number"
    },
    "year": {
      "type": "number"
    },
    "loddtype": {
      "type": "string"
    },
    "loddtype_label": {
      "type": "string",
      "description": "Custom display name for sesong lodd slots"
    },
    "man_inng": {
      "type": "number",
      "default": 0
    },
    "man_akt": {
      "type": "number",
      "default": 0
    },
    "man_salg": {
      "type": "number",
      "default": 0
    },
    "tir_inng": {
      "type": "number",
      "default": 0
    },
    "tir_akt": {
      "type": "number",
      "default": 0
    },
    "tir_salg": {
      "type": "number",
      "default": 0
    },
    "ons_inng": {
      "type": "number",
      "default": 0
    },
    "ons_akt": {
      "type": "number",
      "default": 0
    },
    "ons_salg": {
      "type": "number",
      "default": 0
    },
    "tor_inng": {
      "type": "number",
      "default": 0
    },
    "tor_akt": {
      "type": "number",
      "default": 0
    },
    "tor_salg": {
      "type": "number",
      "default": 0
    },
    "fre_inng": {
      "type": "number",
      "default": 0
    },
    "fre_akt": {
      "type": "number",
      "default": 0
    },
    "fre_salg": {
      "type": "number",
      "default": 0
    },
    "lor_inng": {
      "type": "number",
      "default": 0
    },
    "lor_akt": {
      "type": "number",
      "default": 0
    },
    "lor_salg": {
      "type": "number",
      "default": 0
    },
    "son_inng": {
      "type": "number",
      "default": 0
    },
    "son_akt": {
      "type": "number",
      "default": 0
    },
    "son_salg": {
      "type": "number",
      "default": 0
    },
    "slutt_fysisk": {
      "type": "number",
      "default": 0
    },
    "differanse": {
      "type": "number",
      "default": 0
    },
    "kommentar": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "butikk",
    "uke_nummer",
    "year",
    "loddtype"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sub_admin"
          }
        },
        {
          "user_condition": {
            "role": "butikksjef"
          }
        }
      ]
    }
  }
}