{
  "name": "Availability",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "worker_id": {
      "type": "string",
      "description": "Worker ID"
    },
    "worker_name": {
      "type": "string",
      "description": "Worker name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of availability"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ],
      "default": "unavailable",
      "description": "Available or unavailable"
    },
    "note": {
      "type": "string",
      "description": "Optional note"
    }
  },
  "required": [
    "worker_id",
    "date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}