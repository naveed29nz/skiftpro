{
  "name": "Stamp",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "stamp_in": {
      "type": "string",
      "description": "ISO datetime of stamp in"
    },
    "stamp_out": {
      "type": "string",
      "description": "ISO datetime of stamp out"
    },
    "stamp_in_lat": {
      "type": "number"
    },
    "stamp_in_lng": {
      "type": "number"
    },
    "stamp_out_lat": {
      "type": "number"
    },
    "stamp_out_lng": {
      "type": "number"
    },
    "is_within_range": {
      "type": "boolean",
      "default": false
    },
    "distance_meters": {
      "type": "number"
    }
  },
  "required": [
    "worker_id",
    "worker_name",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sub_admin"
          }
        },
        {
          "user_condition": {
            "role": "butikksjef"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sub_admin"
          }
        },
        {
          "user_condition": {
            "role": "butikksjef"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sub_admin"
          }
        },
        {
          "user_condition": {
            "role": "butikksjef"
          }
        }
      ]
    }
  }
}