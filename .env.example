# Public client config. The publishable key is safe to ship in the browser.
# Never put the service_role key in a VITE_ variable or commit it.
# Production and Vercel Preview must not share these. See docs/PREVIEW_ENV.md.
# On Vercel, set Production and Preview separately. Do not inherit Production into Preview.
VITE_SUPABASE_URL=https://iobsolszrmigdmdydfbe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ltaNA7nnVozoSCOcZIjg

# Used only by scripts/import-base44.mjs on your machine. Do not commit real values.
# SUPABASE_URL=https://iobsolszrmigdmdydfbe.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# BASE44_APP_ID=
# BASE44_ACCESS_TOKEN=
# BASE44_SERVER_URL=https://base44.app

# Edge-function secrets. Set these in Supabase, never in Vite and never commit real values.
# SIGNING_PROVIDER=simple_otp
# IDURA_CLIENT_ID=
# IDURA_CLIENT_SECRET=
# IDURA_WEBHOOK_SECRET=
# SIGNICAT_CLIENT_ID=
# SIGNICAT_CLIENT_SECRET=
# SIGNICAT_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=SkiftPro <noreply@skiftpro.no>
# SIGNING_DEV_OTP=true
# Posten Signering. The P12 is the Zastek AS virksomhetssertifikat (Buypass or
# Commfides), base64-encoded. ENV is test or production. Do not set these in Vite.
# POSTEN_SIGNERING_CERT_P12=
# POSTEN_SIGNERING_CERT_PASSWORD=
# POSTEN_SIGNERING_ENV=test

